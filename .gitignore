node_modules/
.project_id
.github_repo
.env
.env.*

# Build output.
.vercel/output/
.tanstack/

# Runtime scan bookkeeping — per-deployment state, not source. Committing it
# would hand every environment another environment's cadence clock.
public/desk-state.json
public/*.json.tmp-*

# Local clock log and lock (scripts/tick.mjs).
logs/
scripts/tick-hidden.vbs
public/desk-lead-cache.json
public/desk-reader-*.json
public/desk-rows-*.json
public/desk-tick-usage.json
# What a local tick writes out beside the payload. The deployed desk builds
# these from the database on every cycle, so a committed copy is only ever
# one machine's last run showing up as a diff in everybody else's.
public/desk-fronts-extra.json
public/desk-tally.json

.vercel
.env*
public/desk-tick-lock.json

# Local build folder and runtime counters (not source).
.output/
public/desk-cpu-meter.json
public/desk-site-seen.json
